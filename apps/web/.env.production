# Vercel rewrites do not proxy WebSocket upgrades, so the live stream must
# connect directly to the Render API host instead of same-origin.
VITE_WS_URL=wss://suryakavach-api.onrender.com/ws/live

# REST intentionally left same-origin (/api) so the vercel.json rewrite applies
# and the browser makes no cross-origin requests. Override only if that changes.
