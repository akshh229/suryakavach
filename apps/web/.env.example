# Copy to .env.local to override locally. Both are optional: with neither set,
# the app talks to its own origin and the Vite dev proxy forwards to :8000.

# Direct WebSocket endpoint. Required in production (Vercel cannot proxy WS).
# VITE_WS_URL=wss://suryakavach-api.onrender.com/ws/live

# REST base path. Leave unset to use the same-origin /api rewrite.
# VITE_API_BASE=http://127.0.0.1:8000/api
